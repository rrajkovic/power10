# Copy this file to `.env` (same folder) and fill it in. `.env` is never
# committed. Restart Supabase afterwards: supabase stop && supabase start
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini models to try, in order, separated by commas.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
